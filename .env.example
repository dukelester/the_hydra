# TheHydra environment variables
# Copy to .env and replace placeholder values. Never commit secrets.

DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=0e89be52db75a4cfe249a8af6bb0022b8a5b7aadbf168975bac33a5e3bb809e5
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:8000
WEB_PORT=8000

# Local without Docker: set this to true so Django uses SQLite.
USE_SQLITE=true

POSTGRES_DB=thehydra
POSTGRES_USER=thehydra
POSTGRES_PASSWORD=?Xm+Wuh&0sTAJwzdXWxSm@:OP_2
POSTGRES_HOST=db
POSTGRES_PORT=5432

DATABASE_URL=postgres://thehydra:?Xm+Wuh&0sTAJwzdXWxSm@:OP_2@db:5432/thehydra

# Optional: load demo data on container start (true/false)
LOAD_DEMO_DATA=true

# Uploads: PDFs, Word, Excel. Files larger than 2MB go to disk, not RAM.
THEHYDRA_MAX_UPLOAD_MB=100

# Email (console in development). Password reset needs an address on the profile.
DEFAULT_FROM_EMAIL=H.Y.D.R.A. <noreply@localhost>
