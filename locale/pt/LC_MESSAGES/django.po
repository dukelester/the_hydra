msgid "Find projects, institutions, policies, and source documents. Choose a type to browse, or type a name, county, contractor, or words inside a file."
msgstr "Encontre projetos, instituições, políticas e documentos. Escolha um tipo, ou escreva um nome, território, empreiteiro ou palavras dentro de um ficheiro."

msgid "The main path"
msgstr "O caminho principal"

msgid "Country"
msgstr "País"

msgid "No institutions match these filters."
msgstr "Nenhuma instituição corresponde a estes filtros."

msgid "No source documents match these filters."
msgstr "Nenhum documento-fonte corresponde a estes filtros."

msgid "Show"
msgstr "Mostrar"

msgid "All types"
msgstr "Todos os tipos"

msgid "Any status"
msgstr "Qualquer estado"

